#toasts{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:10000;display:flex;flex-direction:column;gap:10px;pointer-events:none;width:calc(100% - 32px);max-width:420px}
.toast{padding:12px 20px;border-radius:999px;background:#0F172A;border:1px solid var(--bd);box-shadow:0 12px 40px rgba(0,0,0,.4);font-size:13px;font-weight:700;text-align:center;pointer-events:auto;animation:tIn .25s ease}
.toast.s{border-color:rgba(37,211,102,.5);color:var(--green)}
.toast.e{border-color:rgba(255,107,107,.5);color:var(--coral)}
.toast.i{border-color:rgba(0,217,255,.5);color:var(--cyan)}
@keyframes tIn{from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:translateY(0)}}
.auth{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:20px}
.auth-card{width:100%;max-width:420px;background:var(--card);border:1px solid var(--bd);border-radius:26px;padding:32px 24px;box-shadow:0 20px 60px rgba(0,0,0,.4)}
.auth-logo{width:56px;height:56px;margin:0 auto 14px;border-radius:50%;background:linear-gradient(135deg,var(--coral),var(--purple));display:flex;align-items:center;justify-content:center;font-size:24px;overflow:hidden}
.dots{display:flex;gap:12px;justify-content:center;margin:22px 0}
.dot{width:16px;height:16px;border-radius:50%;border:2px solid var(--bd);transition:all .2s}
.dot.f{background:var(--coral);border-color:var(--coral)}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}
.keypad button{height:60px;border-radius:16px;background:var(--card);border:1px solid var(--bd);font-size:22px;font-weight:800}
.user-select{display:flex;flex-direction:column;gap:10px;margin-bottom:18px}
.user-item{padding:14px 16px;border-radius:12px;background:var(--card);border:1px solid var(--bd);cursor:pointer;display:flex;align-items:center;gap:12px}
.app{min-height:100dvh;position:relative}
.header{margin-left:274px;background:#0A0C18;border-bottom:1px solid var(--bd);padding:22px 16px 18px 16px;text-align:center;position:sticky;top:0;z-index:40;display:flex;flex-direction:column;align-items:center;justify-content:center}
.h-logo{width:44px;height:44px;margin:0 auto 8px;border-radius:50%;background:linear-gradient(135deg,var(--coral),var(--purple));display:flex;align-items:center;justify-content:center;font-size:20px;overflow:hidden}
.h-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;text-align:center;width:100%;display:block;line-height:1.3;max-width:100%;word-wrap:break-word}
.h-sub{font-size:11px;color:var(--coral);font-weight:800;letter-spacing:.14em;margin-bottom:12px}
.h-info{display:inline-block;padding:8px 16px;background:var(--card);border:1px solid var(--bd);border-radius:12px;font-size:11px;margin-bottom:12px}
.h-info .t{font-family:ui-monospace,monospace;font-size:15px;font-weight:800;color:var(--coral);margin-top:3px}
.h-acts{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.nav{position:fixed;left:14px;top:14px;z-index:90;width:246px;height:calc(100dvh - 28px);display:flex;flex-direction:column;background:#12162A;border:1px solid rgba(255,255,255,.1);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.5);overflow:hidden}
.nav-header{padding:12px 12px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:10px}
.nscroll{flex:1;display:flex;flex-direction:column;gap:6px;overflow-y:auto;overflow-x:hidden;padding:10px 8px;scrollbar-width:thin}
.ntab{position:relative;display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:12px;background:transparent;border:1px solid transparent;cursor:pointer;transition:all .2s;width:100%;text-align:left;font-size:13px;font-weight:700;color:var(--dim)}
.ntab:hover{background:rgba(255,255,255,.06);color:var(--txt)}
.ntab.on{background:rgba(255,107,107,.15);border-color:rgba(255,107,107,.35);color:var(--txt)}
.ntab .lbl{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.narrow{width:100%;height:32px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.04);border-top:1px solid rgba(255,255,255,.06);font-size:18px;font-weight:800;color:var(--dim);cursor:pointer}
.narrow:first-of-type{border-bottom:1px solid rgba(255,255,255,.06);border-top:none}
.nav:hover .narrow{color:var(--txt)}
.content{margin-left:274px;padding:18px 18px 24px 18px;min-height:calc(100dvh - 120px)}
.card{position:relative;background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:16px;overflow:hidden}
.stat{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px;text-align:center}
.stat-l{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin-bottom:4px}
.stat-v{font-size:22px;font-weight:900;color:var(--txt)}
.btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 18px;border-radius:999px;background:var(--card);border:1px solid var(--bd);font-weight:800;font-size:12px;transition:all .15s}
.btn:hover{background:var(--card-h)}
.btn:active{transform:scale(0.97)}
.btn-p{background:linear-gradient(135deg,var(--coral),var(--purple));border-color:transparent;color:white}
.btn-s{font-size:11px;padding:9px 14px}
.btn-d{background:rgba(255,107,107,.15);color:var(--coral);border-color:rgba(255,107,107,.3)}
.btn-full{width:100%}
.btn-sm{padding:6px 10px;font-size:11px}
.grid{display:grid;gap:14px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
.badge{display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;background:var(--card);border:1px solid var(--bd);font-size:10px;font-weight:800;letter-spacing:.06em}
.empty{padding:32px 20px;text-align:center;background:var(--card);border:1px dashed var(--bd);border-radius:16px}
.lbl{font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);display:block;margin-bottom:6px}
.fld{margin-bottom:12px}
.avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--coral),var(--purple));display:flex;align-items:center;justify-content:center;font-weight:900;color:white;overflow:hidden}
.countdown-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:10px}
.countdown-box{background:rgba(0,0,0,.25);border:1px solid var(--bd);border-radius:10px;padding:8px 4px;text-align:center}
.countdown-box .num{font-size:18px;font-weight:900;color:var(--coral)}
.countdown-box .lab{font-size:8px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-top:2px}
.footer3d{margin-left:274px;margin-top:40px;padding:20px 18px;background:#0A0C18;border-top:1px solid var(--bd);text-align:center}
.footer3d .ft-text{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.footer3d .ft-text span{color:var(--coral)}
.modal-bd{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(5,7,16,.75)}
.modal{width:100%;max-width:580px;max-height:88dvh;overflow:auto;background:#161A30;border:1px solid rgba(255,255,255,.14);border-radius:22px;padding:20px;box-shadow:0 30px 90px rgba(0,0,0,.7)}
@media(max-width:900px){
